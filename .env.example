# LLM 供应商配置
# 密钥只能保存在服务端环境变量中，绝不能提交真实值，也不能写进前端代码。
# 复制本文件为 .env.local 并填入真实值（.env.local 已被 git 忽略）。

# 审阅/对话使用的模型供应商，目前支持 OpenAI 兼容接口
LLM_PROVIDER=openai

# API Key（或兼容接口的密钥）
OPENAI_API_KEY=

# 兼容接口的 base URL。使用官方 OpenAI 时留空；DeepSeek 填 https://api.deepseek.com
OPENAI_BASE_URL=

# 审阅和对话使用的模型名。
# DeepSeek 可用：deepseek-flash、deepseek-v4-pro
# 注意：推理模型会消耗 reasoning token，若审阅返回空结果需提高 max_tokens。
LLM_MODEL=deepseek-flash
